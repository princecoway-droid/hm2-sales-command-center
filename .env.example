# =============================================================================
# HM2 Sales Command Center - environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Dashboard -> Project Settings -> API), or from the output of
# `npm run db:start` when working against the local stack.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC - inlined into the browser bundle by Next.js.
# These two are safe to expose: the anon key only ever grants what Row Level
# Security allows.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# PUBLIC - the application's own address, used to build share links.
#
# A share link is the one URL this app produces that has to work somewhere else:
# pasted into WhatsApp and opened on a phone, possibly on another network. When
# this is set it is the authoritative answer to "what is my address"; when it is
# blank the origin is taken from the request's Host / X-Forwarded-* headers,
# which is fine in development and behind a well-behaved proxy.
#
# Set it in production. It is the only source a forwarded header cannot
# influence, and a wrong value here produces a link that does not work.
#
#   NEXT_PUBLIC_APP_URL=https://hm2.example.com
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRET - must never be prefixed with NEXT_PUBLIC_ and must never
# be imported from a Client Component.
#
# The service-role key bypasses Row Level Security completely. This application
# does NOT use it and does not need it in production: every read and write goes
# through the request-scoped client so RLS applies as the signed-in user. Leave
# it blank unless a future server-side admin task needs it (provisioning a user
# outside the Supabase dashboard, say). It is read only through
# src/lib/env.server.ts, which is marked `server-only` so a stray client import
# fails the build instead of leaking the key.
# -----------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL - used only by `npm run db:types` to regenerate database types from a
# hosted project. Find it in your project URL:
# https://supabase.com/dashboard/project/<SUPABASE_PROJECT_ID>
# Leave blank to generate types from the local stack instead.
# -----------------------------------------------------------------------------

SUPABASE_PROJECT_ID=
